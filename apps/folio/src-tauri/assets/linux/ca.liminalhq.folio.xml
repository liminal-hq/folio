<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
	<mime-type type="application/vnd.liminal.folio+zip">
		<comment>Folio book project</comment>
		<sub-class-of type="application/zip" />
		<alias type="application/x-folio" />
		<glob pattern="*.folio" />
		<magic priority="80">
			<match type="string" value="PK\003\004" offset="0">
				<match type="string" value="mimetypeapplication/vnd.liminal.folio+zip" offset="30" />
			</match>
		</magic>
		<generic-icon name="x-office-document" />
	</mime-type>
</mime-info>
