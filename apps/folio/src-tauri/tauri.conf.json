{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Folio",
	"version": "0.0.0",
	"identifier": "ca.liminalhq.folio",
	"build": {
		"beforeDevCommand": "bun run dev",
		"beforeBuildCommand": "bun run build",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"publisher": "Liminal HQ",
		"homepage": "https://github.com/liminal-hq/folio",
		"copyright": "Copyright 2026 Liminal HQ, Scott Morris",
		"license": "Apache-2.0 OR MIT",
		"category": "Productivity",
		"shortDescription": "A local-first book layout app"
	}
}
