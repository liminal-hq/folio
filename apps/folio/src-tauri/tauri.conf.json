{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Folio",
	"version": "0.1.0",
	"identifier": "ca.liminalhq.folio",
	"build": {
		"beforeDevCommand": "bun run dev",
		"beforeBuildCommand": "bun run build",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"publisher": "Liminal HQ",
		"homepage": "https://github.com/liminal-hq/folio",
		"copyright": "Copyright 2026 Liminal HQ, Scott Morris",
		"license": "Apache-2.0 OR MIT",
		"category": "Productivity",
		"shortDescription": "A local-first book layout app",
		"longDescription": "Folio is a local-first book layout app for making print and ebook editions.",
		"fileAssociations": [
			{
				"ext": ["folio"],
				"name": "Folio.folio",
				"description": "A Folio book project",
				"mimeType": "application/vnd.liminal.folio+zip",
				"role": "Editor"
			}
		],
		"linux": {
			"deb": {
				"desktopTemplate": "assets/folio.desktop",
				"postInstallScript": "assets/linux/refresh-desktop-caches.sh",
				"postRemoveScript": "assets/linux/refresh-desktop-caches.sh",
				"files": {
					"/usr/share/mime/packages/ca.liminalhq.folio.xml": "assets/linux/ca.liminalhq.folio.xml",
					"/usr/share/icons/hicolor/scalable/mimetypes/application-vnd.liminal.folio+zip.svg": "assets/file-icons/folio-document.svg",
					"/usr/share/icons/hicolor/16x16/mimetypes/application-vnd.liminal.folio+zip.png": "assets/file-icons/16x16.png",
					"/usr/share/icons/hicolor/24x24/mimetypes/application-vnd.liminal.folio+zip.png": "assets/file-icons/24x24.png",
					"/usr/share/icons/hicolor/32x32/mimetypes/application-vnd.liminal.folio+zip.png": "assets/file-icons/32x32.png",
					"/usr/share/icons/hicolor/48x48/mimetypes/application-vnd.liminal.folio+zip.png": "assets/file-icons/48x48.png",
					"/usr/share/icons/hicolor/64x64/mimetypes/application-vnd.liminal.folio+zip.png": "assets/file-icons/64x64.png",
					"/usr/share/icons/hicolor/128x128/mimetypes/application-vnd.liminal.folio+zip.png": "assets/file-icons/128x128.png",
					"/usr/share/icons/hicolor/256x256/mimetypes/application-vnd.liminal.folio+zip.png": "assets/file-icons/256x256.png"
				}
			},
			"rpm": {
				"desktopTemplate": "assets/folio.desktop",
				"postInstallScript": "assets/linux/refresh-desktop-caches.sh",
				"postRemoveScript": "assets/linux/refresh-desktop-caches.sh",
				"files": {
					"/usr/share/mime/packages/ca.liminalhq.folio.xml": "assets/linux/ca.liminalhq.folio.xml",
					"/usr/share/icons/hicolor/scalable/mimetypes/application-vnd.liminal.folio+zip.svg": "assets/file-icons/folio-document.svg",
					"/usr/share/icons/hicolor/16x16/mimetypes/application-vnd.liminal.folio+zip.png": "assets/file-icons/16x16.png",
					"/usr/share/icons/hicolor/24x24/mimetypes/application-vnd.liminal.folio+zip.png": "assets/file-icons/24x24.png",
					"/usr/share/icons/hicolor/32x32/mimetypes/application-vnd.liminal.folio+zip.png": "assets/file-icons/32x32.png",
					"/usr/share/icons/hicolor/48x48/mimetypes/application-vnd.liminal.folio+zip.png": "assets/file-icons/48x48.png",
					"/usr/share/icons/hicolor/64x64/mimetypes/application-vnd.liminal.folio+zip.png": "assets/file-icons/64x64.png",
					"/usr/share/icons/hicolor/128x128/mimetypes/application-vnd.liminal.folio+zip.png": "assets/file-icons/128x128.png",
					"/usr/share/icons/hicolor/256x256/mimetypes/application-vnd.liminal.folio+zip.png": "assets/file-icons/256x256.png"
				}
			}
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5NDI2RjQ5NDUyNzJFQzMKUldURExpZEZTVzlDK1l1WThJMGF0d1U1TVVvVWhrYUhsRWRjOFhyYkRDdWhkd05vK2tXL0syRVIK",
			"endpoints": ["https://github.com/liminal-hq/folio/releases/latest/download/latest.json"],
			"requireSignedVersion": true,
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
