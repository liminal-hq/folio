{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Folio",
	"version": "0.1.0",
	"identifier": "ca.liminalhq.folio",
	"build": {
		"beforeDevCommand": "bun run dev",
		"beforeBuildCommand": "bun run build",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"publisher": "Liminal HQ",
		"homepage": "https://github.com/liminal-hq/folio",
		"copyright": "Copyright 2026 Liminal HQ, Scott Morris",
		"license": "Apache-2.0 OR MIT",
		"category": "Productivity",
		"shortDescription": "A local-first book layout app",
		"longDescription": "Folio is a local-first book layout app for making print and ebook editions.",
		"fileAssociations": [
			{
				"ext": ["folio"],
				"name": "Folio book",
				"description": "A Folio book project",
				"mimeType": "application/x-folio",
				"role": "Editor"
			}
		],
		"linux": {
			"deb": {
				"desktopTemplate": "assets/folio.desktop"
			},
			"rpm": {
				"desktopTemplate": "assets/folio.desktop"
			}
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5NDI2RjQ5NDUyNzJFQzMKUldURExpZEZTVzlDK1l1WThJMGF0d1U1TVVvVWhrYUhsRWRjOFhyYkRDdWhkd05vK2tXL0syRVIK",
			"endpoints": ["https://github.com/liminal-hq/folio/releases/latest/download/latest.json"],
			"requireSignedVersion": true,
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
